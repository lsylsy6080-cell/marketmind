# Termux worker login: use a local PostgreSQL connection, never expose port 5432.
DATABASE_URL=postgresql://buddy4_worker:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:5432/marketmind_migration_test
# API SELECT connection must use the separate read-only login.
BUDDY4_API_DATABASE_URL=postgresql://buddy4_dashboard:REPLACE_WITH_DIFFERENT_SECRET@127.0.0.1:5432/marketmind_migration_test
BUDDY4_API_PORT=8787
BUDDY4_API_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
BUDDY4_JOB_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
ETF_SOURCE=farside
ETF_ASSET=BTC
ETF_MARKET=US
