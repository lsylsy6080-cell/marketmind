# Required for MarketMind dashboard data
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional public Supabase keys (only needed by browser/auth features)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: Project Center integrations
GITHUB_REPOSITORY=owner/repository
GITHUB_BRANCH=main
GITHUB_TOKEN=
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: external health endpoints
MARKET_WORKER_HEALTH_URL=
MARKET_API_HEALTH_URL=
INTELLIGENCE_HEALTH_URL=
